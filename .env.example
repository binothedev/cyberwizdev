# .env.example
# Copy this to .env and fill in your values

# Database
DATABASE_URL="mysql://user:password@localhost:3306/cyberwizdev"

# NextAuth.js
AUTH_SECRET="your-secret-key-here" # Generate with: openssl rand -base64 32
AUTH_URL="http://localhost:3000"

# SMTP Configuration (for sending newsletters)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@cyberwizdev.com"

# WhatsApp
WHATSAPP_PHONE_NUMBER="1234567890" # Your WhatsApp number (country code + number, no + or spaces)