# .env.example
# Copy this to .env and fill in your values

# Database
DATABASE_URL="mysql://user:password@localhost:3306/cyberwizdev"

# Database Relay (PHP api.php that runs SQL on the cPanel host)
# RELAY_URL is the deployed URL of php-relay/api.php
RELAY_URL="https://yourdomain.com/php-relay/api.php"
# RELAY_SECRET must match RELAY_API_SECRET in php-relay/relay-config.php
RELAY_SECRET="change-me"
# Optional: request timestamp validity window (seconds)
RELAY_TTL_SECONDS=60

# NextAuth.js
AUTH_SECRET="your-secret-key-here" # Generate with: openssl rand -base64 32
AUTH_URL="http://localhost:3000"

# SMTP Configuration (for sending newsletters)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@cyberwizdev.com"

# WhatsApp
WHATSAPP_PHONE_NUMBER="1234567890" # Your WhatsApp number (country code + number, no + or spaces)